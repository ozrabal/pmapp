---
import "../styles/global.css";
import { NotificationProvider } from "@/components/ui/notification-provider";
import { LogoutButton } from "@/components/auth/LogoutButton";
import { Button } from "@/components/ui/button";

interface Props {
  title?: string;
}

const { title = "Plan My App" } = Astro.props;

// Check if the user is authenticated
const user = Astro.locals.user;
const isAuthenticated = !!user;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-200">
    <NotificationProvider client:load>
      <header
        class="container w-full flex max-md:flex-col mx-auto px-4 md:px-12 pt-5 pr-6 pb-5 pl-6 max-md:gap-4 max-md:items-start items-center justify-between"
      >
        <span class="flex items-center gap-2 text-xl font-semibold tracking-tight font-geist-mono">
          <span
            class="inline-block w-5 h-5 bg-gradient-to-br rounded-full mr-2 shadow-lg from-blue-950 to-blue-950 shadow-neutral-800"
          ></span>
          <span class="bg-clip-text bg-gradient-to-r font-geist-mono text-white"> Plan My App </span>
        </span>

        {
          isAuthenticated && (
            <nav>
              <ul class="flex gap-8 text-sm font-medium items-center">
                <li>
                  <span class="opacity-80 hover:opacity-100 transition font-geist-mono">{user?.email}</span>
                </li>
                <li>
                  <a href="/dashboard" class="opacity-80 hover:opacity-100 transition font-geist-mono">
                    <Button variant="link">Dashboard</Button>
                  </a>
                </li>
                <li>
                  <LogoutButton variant="outline" size="sm" client:load />
                </li>
              </ul>
            </nav>
          )
        }
      </header>
      <main class="container mx-auto px-4 md:px-12">
        <slot />
      </main>
    </NotificationProvider>
    <footer class="py-8 mt-16">
      <div class="text-center text-gray-600 dark:text-gray-400">
        <p>&copy; 2025 Plan My App. All rights reserved.</p>
        <p>Made with ⚡ by <a href="https://webkowski.com">Webkowski</a></p>
      </div>
    </footer>
  </body>
</html>
